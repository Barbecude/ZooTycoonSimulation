{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": [
          "body"
        ],
        "model": {
          "type": "composite",
          "models": [
            {
              "type": "minecraft:model",
              "model": "physical_vehicles:vehicle/zcbm_ural_cola/body"
            },
            {
              "type": "select",
              "property": "custom_model_data",
              "index": 1,
              "fallback": {
                "type": "empty"
              },
              "cases": [
                {
                  "when": "parking_lights",
                  "model": {
                    "type": "minecraft:model",
                    "model": "physical_vehicles:vehicle/zcbm_ural_cola/parking_lights"
                  }
                },
                {
                  "when": "headlights",
                  "model": {
                    "type": "minecraft:model",
                    "model": "physical_vehicles:vehicle/zcbm_ural_cola/headlights"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "when": [
          "wheel"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "physical_vehicles:vehicle/zcbm_ural_cola/wheel"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "physical_vehicles:vehicle/zcbm_ural_cola/item"
    }
  }
}